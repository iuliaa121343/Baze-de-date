--cursori/exceptii

DECLARE
    CURSOR c_produse IS 
        SELECT id_produs, cantitate_produs 
        FROM Produs;
    v_id_produs Produs.id_produs%TYPE;
    v_cantitate_produs Produs.cantitate_produs%TYPE;
BEGIN
    OPEN c_produse;
    LOOP
        FETCH c_produse INTO v_id_produs, v_cantitate_produs;
        EXIT WHEN c_produse%NOTFOUND;
        BEGIN
            UPDATE Produs
            SET cantitate_produs = cantitate_produs + 5
            WHERE id_produs = v_id_produs;

            DBMS_OUTPUT.PUT_LINE('Produsul cu ID ' || v_id_produs || ' a fost actualizat.');
        EXCEPTION
            WHEN OTHERS THEN
                DBMS_OUTPUT.PUT_LINE('Eroare la actualizarea produsului cu ID ' || v_id_produs || ': ' || SQLERRM);
        END;
    END LOOP;
    CLOSE c_produse;
END;


DECLARE
    CURSOR c_produs IS 
        SELECT id_produs, nume_produs, pret_produs 
        FROM Produs
        WHERE id_produs = 10;
    v_id_produs Produs.id_produs%TYPE;
    v_nume_produs Produs.nume_produs%TYPE;
    v_pret_produs Produs.pret_produs%TYPE;
BEGIN
    OPEN c_produs;
    FETCH c_produs INTO v_id_produs, v_nume_produs, v_pret_produs;

    IF c_produs%NOTFOUND THEN
        RAISE NO_DATA_FOUND;
    ELSE
        DBMS_OUTPUT.PUT_LINE('Produs ID: ' || v_id_produs || ', Nume: ' || v_nume_produs || ', Preț: ' || v_pret_produs);
    END IF;

    CLOSE c_produs;
EXCEPTION
    WHEN NO_DATA_FOUND THEN
        DBMS_OUTPUT.PUT_LINE('Produsul cu ID specificat nu a fost găsit.');
    WHEN OTHERS THEN
        DBMS_OUTPUT.PUT_LINE('A apărut o eroare: ' || SQLERRM);
END;
/



DECLARE
    CURSOR c_stoc IS
        SELECT id_produs, nume_produs, cantitate_produs
        FROM Produs
        WHERE cantitate_produs < 10;
    v_id_produs Produs.id_produs%TYPE;
    v_nume_produs Produs.nume_produs%TYPE;
    v_cantitate_produs Produs.cantitate_produs%TYPE;
BEGIN
    OPEN c_stoc;
    LOOP
        FETCH c_stoc INTO v_id_produs, v_nume_produs, v_cantitate_produs;
        EXIT WHEN c_stoc%NOTFOUND;

        BEGIN
            DBMS_OUTPUT.PUT_LINE('Produsul cu ID ' || v_id_produs || 
                                 ' (' || v_nume_produs || 
                                 ') are stoc redus: ' || v_cantitate_produs);
        EXCEPTION
            WHEN OTHERS THEN
                DBMS_OUTPUT.PUT_LINE('Eroare la verificarea stocului pentru produsul cu ID ' || v_id_produs || ': ' || SQLERRM);
        END;
    END LOOP;
    CLOSE c_stoc;
END;
/


DECLARE
    v_total_stoc NUMBER;
BEGIN
    FOR r_produs IN (SELECT id_produs, nume_produs, cantitate_produs, pret_produs 
                     FROM Produs) LOOP
        BEGIN
            v_total_stoc := r_produs.cantitate_produs * r_produs.pret_produs;
            DBMS_OUTPUT.PUT_LINE('Produs: ' || r_produs.nume_produs || 
                                 ', ID: ' || r_produs.id_produs || 
                                 ', Valoare totală: ' || v_total_stoc);
        EXCEPTION
            WHEN OTHERS THEN
                DBMS_OUTPUT.PUT_LINE('Eroare la calcularea valorii pentru produsul cu ID ' || r_produs.id_produs || ': ' || SQLERRM);
        END;
    END LOOP;
END;
/


--FUNCTII
CREATE OR REPLACE FUNCTION calcul_valoare_totala(
    p_id_produs IN Produs.id_produs%TYPE
) RETURN NUMBER IS
    v_valoare_totala NUMBER;
BEGIN
    SELECT cantitate_produs * pret_produs
    INTO v_valoare_totala
    FROM Produs
    WHERE id_produs = p_id_produs;

    RETURN v_valoare_totala;
EXCEPTION
    WHEN NO_DATA_FOUND THEN
        RETURN 0;
    WHEN OTHERS THEN
        RETURN NULL;
END;
/


CREATE OR REPLACE FUNCTION este_disponibil(
    p_id_produs IN Produs.id_produs%TYPE
) RETURN BOOLEAN IS
    v_cantitate NUMBER;
BEGIN
    SELECT cantitate_produs
    INTO v_cantitate
    FROM Produs
    WHERE id_produs = p_id_produs;

    RETURN v_cantitate > 0;
EXCEPTION
    WHEN NO_DATA_FOUND THEN
        RETURN FALSE;
END;
/

CREATE OR REPLACE FUNCTION calculeaza_pret_reducere(
    p_id_produs IN Produs.id_produs%TYPE,
    p_reducere IN NUMBER
) RETURN NUMBER IS
    v_pret NUMBER;
BEGIN
    SELECT pret_produs
    INTO v_pret
    FROM Produs
    WHERE id_produs = p_id_produs;

    RETURN v_pret - (v_pret * p_reducere / 100);
EXCEPTION
    WHEN NO_DATA_FOUND THEN
        RETURN NULL;
END;
/
--proceduri

CREATE OR REPLACE PROCEDURE actualizeaza_stoc(
    p_id_produs IN Produs.id_produs%TYPE,
    p_cantitate IN NUMBER
) IS
BEGIN
    UPDATE Produs
    SET cantitate_produs = cantitate_produs + p_cantitate
    WHERE id_produs = p_id_produs;

    DBMS_OUTPUT.PUT_LINE('Stocul a fost actualizat pentru produsul cu ID: ' || p_id_produs);
EXCEPTION
    WHEN OTHERS THEN
        DBMS_OUTPUT.PUT_LINE('Eroare la actualizarea stocului: ' || SQLERRM);
END;
/

CREATE OR REPLACE PROCEDURE sterge_produs(
    p_id_produs IN Produs.id_produs%TYPE
) IS
BEGIN
    DELETE FROM Produs
    WHERE id_produs = p_id_produs;

    DBMS_OUTPUT.PUT_LINE('Produsul cu ID ' || p_id_produs || ' a fost șters.');
EXCEPTION
    WHEN NO_DATA_FOUND THEN
        DBMS_OUTPUT.PUT_LINE('Produsul cu ID ' || p_id_produs || ' nu există.');
    WHEN OTHERS THEN
        DBMS_OUTPUT.PUT_LINE('Eroare la ștergerea produsului: ' || SQLERRM);
END;
/

CREATE OR REPLACE PROCEDURE afiseaza_detalii_produs(
    p_id_produs IN Produs.id_produs%TYPE
) IS
    v_nume_produs Produs.nume_produs%TYPE;
    v_pret_produs Produs.pret_produs%TYPE;
    v_cantitate_produs Produs.cantitate_produs%TYPE;
BEGIN
    SELECT nume_produs, pret_produs, cantitate_produs
    INTO v_nume_produs, v_pret_produs, v_cantitate_produs
    FROM Produs
    WHERE id_produs = p_id_produs;

    DBMS_OUTPUT.PUT_LINE('Detalii produs: ');
    DBMS_OUTPUT.PUT_LINE('Nume: ' || v_nume_produs);
    DBMS_OUTPUT.PUT_LINE('Preț: ' || v_pret_produs);
    DBMS_OUTPUT.PUT_LINE('Cantitate: ' || v_cantitate_produs);
EXCEPTION
    WHEN NO_DATA_FOUND THEN
        DBMS_OUTPUT.PUT_LINE('Produsul cu ID ' || p_id_produs || ' nu a fost găsit.');
    WHEN OTHERS THEN
        DBMS_OUTPUT.PUT_LINE('Eroare la afișarea detaliilor produsului: ' || SQLERRM);
END;
/

