--structuri de control 
DECLARE
    v_status_comanda VARCHAR2(20);
BEGIN
    SELECT status_comanda
    INTO v_status_comanda
    FROM Comanda
    WHERE id_comanda = 12;

    IF v_status_comanda = 'Neplatita' THEN
        UPDATE Comanda
        SET status_comanda = 'Platita'
        WHERE id_comanda = 1;
        DBMS_OUTPUT.PUT_LINE('Statusul comenzii a fost actualizat la Platita.');
    ELSE
        DBMS_OUTPUT.PUT_LINE('Statusul comenzii nu necesită actualizare.');
    END IF;
END;



DECLARE
    v_id_produs Produs.id_produs%TYPE;
    v_cantitate_produs Produs.cantitate_produs%TYPE;
    CURSOR c_produs IS
        SELECT id_produs, cantitate_produs
        FROM Produs
        WHERE cantitate_produs < 10;
BEGIN
    OPEN c_produs;
    LOOP
        FETCH c_produs INTO v_id_produs, v_cantitate_produs;
        EXIT WHEN c_produs%NOTFOUND;

        WHILE v_cantitate_produs < 10 LOOP
            v_cantitate_produs := v_cantitate_produs + 1;
        END LOOP;

        UPDATE Produs
        SET cantitate_produs = v_cantitate_produs
        WHERE id_produs = v_id_produs;

        DBMS_OUTPUT.PUT_LINE('Produsul cu ID ' || v_id_produs || ' a fost actualizat cu cantitate ' || v_cantitate_produs || '.');
    END LOOP;
    CLOSE c_produs;
END;


DECLARE
    v_medie_cantitate NUMBER(10,2);
BEGIN
    SELECT AVG(cantitate_produs)
    INTO v_medie_cantitate
    FROM Produs;

    DBMS_OUTPUT.PUT_LINE('Cantitatea medie a produselor este: ' || v_medie_cantitate);

    FOR produs IN (SELECT id_produs, nume_produs, cantitate_produs FROM Produs) LOOP
        IF produs.cantitate_produs > v_medie_cantitate THEN
            DBMS_OUTPUT.PUT_LINE('Produsul ' || produs.nume_produs || ' are cantitate peste medie.');
        ELSE
            DBMS_OUTPUT.PUT_LINE('Produsul ' || produs.nume_produs || ' are cantitate sub medie.');
        END IF;
    END LOOP;
END;


